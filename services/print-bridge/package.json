{
  "name": "print-bridge",
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts",
    "dev:sim": "tsx src/dev.ts",
    "bridge:dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=build/bridge.cjs",
    "build:sea": "powershell -NoProfile -ExecutionPolicy Bypass -File ./windows/build-sea.ps1"
  },
  "dependencies": {
    "@delivery/core": "workspace:*",
    "@sentry/node": "^10.70.0",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
