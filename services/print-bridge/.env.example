# HAWSMASH 2.0 — print-bridge (um ficheiro .env por loja)

# Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORE_ID=00000000-0000-0000-0000-000000000000
BRIDGE_DEVICE_ID=00000000-0000-0000-0000-000000000001
BRIDGE_APP_VERSION=2.0.0

# Impressoras ESC/POS na LAN desta loja.
PRINTER_IP_KITCHEN=192.168.1.50
PRINTER_IP_COUNTER=192.168.1.51
PRINTER_PORT=9100
POLL_INTERVAL_MS=3000

# Servidor local usado pelo POS offline (implementado na F3/F4).
LOCAL_HTTP_PORT=7777
LOCAL_TOKEN=generate-a-long-random-token
LOCAL_ALLOWED_ORIGINS=https://staging.example.com,https://www.example.com
LOCAL_STATE_FILE=./data/printed-requests.log

# Visor do cliente (mostrador de 2 linhas do PC touch) — B-018.
# Vazio = desligado, e o bridge corre exactamente como antes.
# 'sim' escreve as tramas na consola, para desenvolver sem hardware.
# A porta descobre-se no Gestor de Dispositivos → Portas (COM e LPT).
CUSTOMER_DISPLAY_PORT=
CUSTOMER_DISPLAY_BAUD=9600
CUSTOMER_DISPLAY_COLUMNS=20
# cd5220 (a maioria dos visores genéricos) | escpos (Epson DM-D)
CUSTOMER_DISPLAY_PROTOCOL=cd5220
CUSTOMER_DISPLAY_IDLE_TEXT=HAWSMASH
CUSTOMER_DISPLAY_IDLE_SUBTEXT=BEM-VINDO
CUSTOMER_DISPLAY_IDLE_STEP_MS=300
CUSTOMER_DISPLAY_IDLE_AFTER_MS=90000

# Development mode (simulator)
# Set USE_SIMULATOR=true to use the TCP simulator instead of real printer
USE_SIMULATOR=false
SIMULATOR_PORT=9100
SIMULATOR_VERBOSE=false

# Sentry (opcional; sem DSN o bridge corre na mesma) — B-013
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
