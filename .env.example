# ─────────────────────────────────────────────────────────────────────────────
# HAWSMASH 2.0 — variáveis de ambiente (uma empresa, duas lojas)
# Copia este ficheiro para .env.local no desenvolvimento e preenche os placeholders.
# Valida com:  pnpm setup:client --check
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (obrigatório) ───────────────────────────────────────────────────
# Project Settings → API. O URL e a publishable/anon key são públicos (vão para o browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# A service role key é SECRETA — só no servidor. Nunca a exponhas no front.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Testes de integração locais (não são expostas ao browser).
SUPABASE_URL=http://127.0.0.1:54731
SUPABASE_ANON_KEY=your-local-publishable-or-anon-key

# ── Pagamento ────────────────────────────────────────────────────────────────
# manual  = cliente envia comprovativo M-Pesa/e-Mola, dono aprova (default, cobre 100%)
# mock    = simulador Paysuite (para testes do fluxo digital)
# paysuite= Paysuite real (exige as 2 chaves abaixo)
PAYMENT_PROVIDER=manual
PAYSUITE_API_KEY=
PAYSUITE_WEBHOOK_SECRET=

# ── Email transacional — Resend (recomendado) ────────────────────────────────
# Sem RESEND_API_KEY o sistema funciona, mas não envia emails (novo pedido / aprovação / recusa).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@seu-dominio.co.mz
OWNER_EMAIL=dono@restaurante.co.mz

# ── App ──────────────────────────────────────────────────────────────────────
# URL público onde o site está deployado (usado em emails e returns de pagamento).
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
# Nome assinado nos emails (opcional; default "Delivery OS"). Normalmente = brand.name.
BRAND_NAME=
# Protege o cron /api/cron/reconcile (só necessário com Paysuite). Gera um valor aleatório.
CRON_SECRET=

# ── Marketing & Rastreio (FASE 4) ────────────────────────────────────────────
# Preferência: configurar TUDO no admin → tab "Marketing" (IDs públicos + tokens).
# Estas envs são apenas FALLBACK server-side se os tokens não estiverem no admin.
# Os IDs PÚBLICOS (GTM/GA4/Pixel/Ads) configuram-se SÓ no admin (não aqui).
META_CAPI_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GADS_OAUTH_TOKEN=
GADS_CUSTOMER_ID=
GADS_CONVERSION_ACTION=

# ── Print-bridge (corre no PC do BALCAO de cada loja, NAO no deploy web) ─────
# Um .env por loja. Ver docs/HARDWARE.md para IPs e ligacoes.
STORE_ID=                       # uuid da loja (stores.id) — ESTE PC so imprime pedidos desta loja
PRINTER_IP_KITCHEN=192.168.1.50 # impressora da cozinha (comanda)
PRINTER_IP_COUNTER=192.168.1.51 # impressora do balcao (talao + gaveta)
PRINTER_PORT=9100
LOCAL_HTTP_PORT=7777            # servidor HTTP local (POS imprime/abre gaveta sem internet)
LOCAL_TOKEN=                    # token partilhado POS <-> bridge na LAN (gerar aleatorio)
